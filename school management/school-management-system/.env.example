# Copy to .env and adjust. All values below are FAKE examples for local development only.
# Never commit a real .env file or real credentials.

# --- PostgreSQL (docker-compose.yml and backend) ---
POSTGRES_DB=school_management
POSTGRES_USER=school_app
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/school_management
DB_USERNAME=school_app
DB_PASSWORD=change_me_local_only

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Comma-separated explicit origins (no wildcards; credentials are enabled)
CORS_ALLOWED_ORIGINS=http://localhost:5173
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_PATH=./data/uploads
# Attendance: how many days back a teacher may open a register, and the "low attendance" line (percent)
# ATTENDANCE_TEACHER_BACKDATE_DAYS=7
# ATTENDANCE_THRESHOLD_PERCENT=75
# Fees: how many days before its due date an unpaid fee is shown as "due" rather than "not due"
# FEE_DUE_SOON_DAYS=14

# --- Mail (Mailpit in development) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@school.example
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Authentication ---
# REQUIRED in production, at least 32 bytes. Generate one, for example: openssl rand -base64 48
# The dev profile has a throwaway fallback; never reuse it anywhere else.
JWT_SIGNING_SECRET=replace_with_a_long_random_value_of_at_least_48_chars
# Cookies are Secure by default; only the dev profile relaxes this for http://localhost.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# Base URL used in password-reset emails (the frontend origin)
FRONTEND_BASE_URL=http://localhost:5173

# --- Development demo data (dev profile + local database only) ---
# All demo accounts share this password. Leave unset to use the documented default.
# DEMO_PASSWORD=

# --- First administrator for a new deployment (optional) ---
# Created only when BOTH are set and no active admin exists. Remove them after the first start.
# INITIAL_ADMIN_EMAIL=admin@your-school.example
# INITIAL_ADMIN_PASSWORD=
# INITIAL_SCHOOL_NAME=My School
# INITIAL_SCHOOL_CODE=SCHOOL

# --- Frontend (Vite) ---
# Leave unset in development; the Vite dev server proxies /api to the backend.
# VITE_API_BASE_URL=/api/v1
# VITE_DEV_API_TARGET=http://localhost:8080
